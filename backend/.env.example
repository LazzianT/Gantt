# Copy to .env and fill real values. Never commit .env.
# Migrations create schema "pm" with ~15 tables inside the CORP_DB database. Run: npm run migrate, verify: npm run db:tables
# Database: CORP_DB, dedicated schema pm. No FK to hris_worker.
DB_SERVER=
DB_PORT=1433
DB_DATABASE=CORP_DB
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_QUERY_TIMEOUT_MS=5000

PORT=4000
NODE_ENV=development

# Generate a strong random value in production.
JWT_SECRET=
JWT_EXPIRES_IN=8h

EMPLOYEE_CACHE_TTL_SECONDS=300

# Comma-separated NIPs granted elevated roles on NIP login (default: member).
AUTH_ADMIN_NIPS=
AUTH_MANAGER_NIPS=
